# GitLab Configuration
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_URL=https://gitlab.com
# Default project for the legacy /api/v1/merge-requests routes (optional)
GITLAB_PROJECT_ID=123456
# Projects shown in the UI sidebar: comma separated IDs or paths (e.g. group/api,group/front).
# Empty = all projects you are a member of (up to GITLAB_PROJECTS_LIMIT)
GITLAB_PROJECTS=
GITLAB_PROJECTS_LIMIT=100

# AI Configuration
OPENAI_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key
KIMI_API_KEY=your_kimi_api_key
AI_MODEL=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
MLX_API_KEY=mlx-local
MLX_MODEL=mlx-community/Qwen2.5-Coder-32B-Instruct-4bit
MLX_BASE_URL=http://localhost:8081/v1

# Server Configuration
PORT=8080
# SQLite database: settings changed in the UI (override this file) and review results
DB_PATH=data/codereview.db 
# Jira (read-only: task description + comments used as review context)
# Jira Cloud: JIRA_URL=https://twojafirma.atlassian.net, JIRA_EMAIL + JIRA_API_TOKEN
#   (token: https://id.atlassian.com/manage-profile/security/api-tokens)
# Jira Server/Data Center: JIRA_URL + JIRA_API_TOKEN (Personal Access Token), leave JIRA_EMAIL empty
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Limit issue key detection to your projects (comma separated), e.g. SHOP,API
JIRA_PROJECT_KEYS=
JIRA_MAX_COMMENTS=20

# Review behaviour
REVIEW_LANGUAGE=pl
# Publish findings to GitLab: draft = pending review visible only to you until "Submit review",
# comment = regular discussions visible to everyone immediately
REVIEW_POST_TO_GITLAB=true
REVIEW_GITLAB_MODE=draft
# low|medium|high|critical - lowest severity posted to GitLab
REVIEW_MIN_SEVERITY=low
REVIEW_MAX_FILES=30
REVIEW_CONCURRENCY=2
# Project documentation read from the MR branch (files or directories, comma separated)
REVIEW_DOCS_PATHS=README.md,CLAUDE.md,AGENTS.md,CONTRIBUTING.md,ARCHITECTURE.md,docs
# Context budgets (characters) - lower them for small local models
REVIEW_DOCS_MAX_CHARS=12000
REVIEW_FILE_MAX_CHARS=15000
REVIEW_DIFF_MAX_CHARS=12000
# Ollama context window in tokens (default Ollama value is too small for review prompts)
OLLAMA_NUM_CTX=32768

# Review engine
#   llm         - one prompt per file to AI_MODEL (works with local models: ollama, mlx)
#   claude-code - Claude Code agent reviews a fresh checkout of the MR branch (read-only tools)
REVIEW_ENGINE=llm
# claude-code engine: repo clone + per-review worktrees (default: ~/Library/Caches/codereviewAI on macOS)
REVIEW_WORKDIR=
CLAUDE_CODE_BIN=claude
# optional: opus | sonnet | full model id; empty = Claude Code default
CLAUDE_CODE_MODEL=
CLAUDE_CODE_MAX_TURNS=60
REVIEW_AGENT_TIMEOUT_MIN=20
# false = use your claude.ai login (subscription); true = use ANTHROPIC_API_KEY (pay per token)
CLAUDE_CODE_USE_API_KEY=false
